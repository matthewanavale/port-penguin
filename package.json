{
  "name": "port-penguin",
  "version": "1.0.0",
  "private": true,
  "description": "Learn Linux commands and Docker by playing a terminal game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "golden:record": "vitest run src/test/engine.golden.test.ts --update",
    "size": "node --experimental-strip-types src/tools/size.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
