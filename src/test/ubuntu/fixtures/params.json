    {
      "id": "param-at",
      "kind": "script",
      "feature": "param: $@",
      "input": [
        "set -- \"a b\" c",
        "for x in $@; do echo \"[$x]\"; done",
        "echo $@"
      ],
      "stdout": "[a]\n[b]\n[c]\na b c\n",
      "stderr": "",
      "code": 0
    },
    {
      "id": "param-star",
      "kind": "script",
      "feature": "param: $*",
      "input": [
        "set -- a b",
        "IFS=,; echo \"$*\" $*",
        "unset IFS",
        "echo \"$*\""
      ],
      "stdout": "a,b a b\na b\n",
      "stderr": "",
      "code": 0
    },
    {
      "id": "param-at-quoted",
      "kind": "script",
      "feature": "param: \"$@\"",
      "input": [
        "set -- \"a b\" c \"\" d",
        "for x in \"$@\"; do echo \"[$x]\"; done",
        "f() { for x in \"$@\"; do echo \"<$x>\"; done; }",
        "f \"$@\" extra",
        "set --",
        "f \"$@\""
      ],
      "stdout": "[a b]\n[c]\n[]\n[d]\n<a b>\n<c>\n<>\n<d>\n<extra>\n",
      "stderr": "",
      "code": 0
    },
    {
      "id": "param-shift",
      "kind": "script",
      "feature": "param: shift",
      "input": [
        "set -- a b c d",
        "shift; echo $1",
        "shift 2; echo $# $1",
        "shift; echo $?",
        "shift 5",
        "echo code=$?"
      ],
      "stdout": "b\n1 d\n0\ncode=1\n",
      "stderr": "",
      "code": 0
    },
    {
      "id": "param-status",
