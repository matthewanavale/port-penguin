    {
      "id": "word-split",
      "kind": "script",
      "feature": "expand: word splitting IFS",
      "input": [
        "x=\"a b  c\"",
        "for w in $x; do echo \"[$w]\"; done",
        "IFS=:",
        "y=a:b::c",
        "for w in $y; do echo \"[$w]\"; done",
        "IFS=",
        "for w in $x; do echo \"[$w]\"; done",
        "IFS=$' \\t\\n'",
        "for w in \"$x\"; do echo \"[$w]\"; done"
      ],
      "stdout": "[a]\n[b]\n[c]\n[a]\n[b]\n[]\n[c]\n[a b  c]\n[a b  c]\n",
      "stderr": "",
      "code": 0
